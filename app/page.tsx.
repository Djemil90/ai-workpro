"use client";
import {useEffect,useState} from "react";
import {supabase,authHeaders} from "../lib/client";
import type {User} from "@supabase/supabase-js";
import {jsPDF} from "jspdf";
type Lang="de"|"sq"|"it";
const tr={
 de:{login:"Anmelden / Registrieren",email:"E-Mail",password:"Passwort",register:"Registrieren",signIn:"Anmelden",signOut:"Abmelden",title:"Offerten & Rechnungen",type:"Dokument",offer:"Offerte",invoice:"Rechnung",customer:"Kunde",service:"Leistungsbeschreibung",qty:"Menge",price:"Preis CHF",generate:"Mit KI formulieren",save:"Dokument speichern",pdf:"PDF herunterladen",pay:"Pro abonnieren – CHF 9.90/Monat",portal:"Abo verwalten",company:"Firma",address:"Adresse",vat:"MWST",preview:"Vorschau",free:"Kostenlos: bis zu 3 KI-Generierungen pro Monat",status:"Abonnement"},
 sq:{login:"Hyr / Regjistrohu",email:"Email",password:"Fjalëkalimi",register:"Regjistrohu",signIn:"Hyr",signOut:"Dil",title:"Oferta & Fatura",type:"Dokumenti",offer:"Ofertë",invoice:"Faturë",customer:"Klienti",service:"Përshkrimi i punës",qty:"Sasia",price:"Çmimi CHF",generate:"Përpuno me AI",save:"Ruaj dokumentin",pdf:"Shkarko PDF",pay:"Abonohu Pro – CHF 9.90/muaj",portal:"Menaxho abonimin",company:"Kompania",address:"Adresa",vat:"TVSH",preview:"Pamja",free:"Falas: deri 3 gjenerime AI në muaj",status:"Abonimi"},
 it:{login:"Accedi / Registrati",email:"Email",password:"Password",register:"Registrati",signIn:"Accedi",signOut:"Esci",title:"Preventivi & Fatture",type:"Documento",offer:"Preventivo",invoice:"Fattura",customer:"Cliente",service:"Descrizione lavoro",qty:"Quantità",price:"Prezzo CHF",generate:"Migliora con AI",save:"Salva documento",pdf:"Scarica PDF",pay:"Abbonati Pro – CHF 9.90/mese",portal:"Gestisci abbonamento",company:"Azienda",address:"Indirizzo",vat:"IVA",preview:"Anteprima",free:"Gratis: fino a 3 generazioni AI al mese",status:"Abbonamento"}
};
export default function Home(){
 const [lang,setLang]=useState<Lang>("de"),t=tr[lang];
 const [user,setUser]=useState<User|null>(null),[email,setEmail]=useState(""),[password,setPassword]=useState("");
 const [company,setCompany]=useState(""),[address,setAddress]=useState(""),[customer,setCustomer]=useState(""),[description,setDescription]=useState(""),[qty,setQty]=useState(1),[price,setPrice]=useState(100),[vat,setVat]=useState(0),[kind,setKind]=useState("Offerte"),[text,setText]=useState(""),[busy,setBusy]=useState(false),[message,setMessage]=useState(""),[sub,setSub]=useState("free");
 useEffect(()=>{supabase.auth.getUser().then(({data})=>setUser(data.user));const {data:{subscription}}=supabase.auth.onAuthStateChange((_e,s)=>setUser(s?.user||null));return ()=>subscription.unsubscribe()},[]);
 useEffect(()=>{if(!user){setSub("free");return}authHeaders().then(h=>fetch("/api/account",{headers:h})).then(r=>r.json()).then(d=>setSub(d.status||"free")).catch(()=>{})},[user]);
 async function authenticate(register:boolean){setMessage("");const result=register?await supabase.auth.signUp({email,password}):await supabase.auth.signInWithPassword({email,password});setMessage(result.error?.message||(register?"Check your email to confirm registration.":"Signed in."))}
 async function callApi(path:string,body?:object){const headers={...(await authHeaders()),"Content-Type":"application/json"};const r=await fetch(path,{method:"POST",headers,body:JSON.stringify(body||{})});const d=await r.json();if(!r.ok)throw Error(d.error||"Request failed");return d}
 async function generate(){setBusy(true);setMessage("");try{const d=await callApi("/api/generate",{kind,company,customer,description,lang});setText(d.text)}catch(e){setMessage(String(e))}finally{setBusy(false)}}
 async function save(){setBusy(true);try{await callApi("/api/documents",{kind,company,address,customer,description,qty,price,vat,text});setMessage("Saved.")}catch(e){setMessage(String(e))}finally{setBusy(false)}}
 async function billing(path:string){setBusy(true);try{const d=await callApi(path);location.href=d.url}catch(e){setMessage(String(e));setBusy(false)}}
 function downloadPDF(){const pdf=new jsPDF();const lines=[kind,company,address,`Kunde: ${customer}`,`Datum: ${new Date().toLocaleDateString("de-CH")}`,"",description,`Menge: ${qty}   Preis CHF: ${price.toFixed(2)}`,`MWST: ${vat}%`,`Total CHF: ${(Math.round(qty*price*(1+vat/100)*100)/100).toFixed(2)}`,"",text];let y=20;for(const line of lines){for(const l of pdf.splitTextToSize(line||" ",170)){if(y>275){pdf.addPage();y=20}pdf.text(l,20,y);y+=7}}pdf.save(`${kind.toLowerCase()}-${Date.now()}.pdf`)}
 return <><header><b>✦ AI WorkPro Switzerland</b> <select aria-label="Language" value={lang} onChange={e=>setLang(e.target.value as Lang)} style={{width:160,float:"right"}}><option value="de">Deutsch</option><option value="sq">Shqip</option><option value="it">Italiano</option></select></header><main>
 {!user?<section className="panel" style={{maxWidth:500,margin:"auto"}}><h2>{t.login}</h2><label>{t.email}</label><input type="email" value={email} onChange={e=>setEmail(e.target.value)}/><label>{t.password}</label><input type="password" minLength={8} value={password} onChange={e=>setPassword(e.target.value)}/><button onClick={()=>authenticate(false)}>{t.signIn}</button><button onClick={()=>authenticate(true)}>{t.register}</button><p className="muted">{message}</p></section>:<>
 <div className="panel" style={{marginBottom:18}}><b>{user.email}</b> · {t.status}: {sub} <button onClick={()=>supabase.auth.signOut()} style={{float:"right"}}>{t.signOut}</button><p className="muted">{t.free}</p><button disabled={busy} onClick={()=>billing("/api/checkout")}>{t.pay}</button><button disabled={busy} onClick={()=>billing("/api/portal")}>{t.portal}</button></div>
 <div className="layout"><section className="panel"><h2>{t.title}</h2><label>{t.type}</label><select value={kind} onChange={e=>setKind(e.target.value)}><option value="Offerte">{t.offer}</option><option value="Rechnung">{t.invoice}</option></select>
 <label>{t.company}</label><input value={company} onChange={e=>setCompany(e.target.value)}/><label>{t.address}</label><textarea value={address} onChange={e=>setAddress(e.target.value)}/><label>{t.customer}</label><input value={customer} onChange={e=>setCustomer(e.target.value)}/><label>{t.service}</label><textarea value={description} onChange={e=>setDescription(e.target.value)}/>
 <div className="row"><div><label>{t.qty}</label><input type="number" min="0" value={qty} onChange={e=>setQty(Number(e.target.value))}/></div><div><label>{t.price}</label><input type="number" min="0" value={price} onChange={e=>setPrice(Number(e.target.value))}/></div><div><label>{t.vat}</label><select value={vat} onChange={e=>setVat(Number(e.target.value))}><option value="0">0%</option><option value="8.1">8.1%</option><option value="2.6">2.6%</option><option value="3.8">3.8%</option></select></div></div>
 <p><b>Total CHF {(Math.round(qty*price*(1+vat/100)*100)/100).toFixed(2)}</b></p><button disabled={busy||!description.trim()} onClick={generate}>{t.generate}</button><button disabled={busy} onClick={save}>{t.save}</button><button onClick={downloadPDF}>{t.pdf}</button><p className="error">{message}</p></section>
 <section className="panel"><h2>{t.preview}</h2><div className="preview"><b>{kind}</b>{"\n"}{company}{"\n"}{address}{"\n\n"}{customer}{"\n\n"}{description}{"\n"}{qty} × CHF {price.toFixed(2)}{"\n"}MWST {vat}%{"\n"}<b>Total CHF {(Math.round(qty*price*(1+vat/100)*100)/100).toFixed(2)}</b>{"\n\n"}{text}</div><label>AI text (editable)</label><textarea value={text} onChange={e=>setText(e.target.value)} rows={8}/><p className="muted">Verify all invoice details, VAT eligibility, and legal requirements before issuing. PDF uses standard fonts; non-ASCII characters may require a Unicode font in a later release.</p></section></div></>}</main></>
}
